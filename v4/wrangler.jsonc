{
  // v4 prototype on Cloudflare Workers (static assets only).
  // Build first: npm install && npm run build, then: npx wrangler deploy
  "name": "42ai-v4",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
